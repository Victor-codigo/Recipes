{% trans_default_domain 'SearchBarComponent' %}

<section data-controller="SearchBarComponent"
		 class="p-2"
		 data-url-search-autocomplete="{{ data.searchAutoCompleteUrl|escape('html_attr') }}"
		 data-group-id="{{ data.groupId }}">

	<div class="d-inline-flex gap-1">
		<button class="btn  btn-outline-seconary  border-1  border-secondary  border-0 border-bottom  border-start  rounded-0  pe-4"
				type="button"
				data-bs-toggle="collapse"
				data-bs-target=".multi-collapse"
				aria-expanded="false"
				aria-controls="seach_menu">
			<span class="text-secondary">
				{{ 'toggle_button.label'|trans }}
			</span>
			&nbsp;
			<span>
				{{ data.searchValue|lower }}
			</span>
		</button>
	</div>
	<div class="collapse multi-collapse  search_menu"
		 id="search_menu">
		<div class="d-flex  flex-column  row-gap-3  border-start  border-secondary">
			<form id="{{ formName }}"
				  name="{{ formName }}"
				  class="search-bar  contaniner  p-3  d-flex  flex-column  row-gap-3  card card-body"
				  action="{{ data.searchFormActionUrl|escape('html_attr') }}"
				  method="post"
				  enctype="multipart/form-data"
				  novalidate
				  data-js-searchbar-form>

				<input type="hidden"
					   name="{{ searchTokenCsrfFieldName }}"
					   value="{{ data.searchCsrfToken }}" />

				<label {{this.sectionFilters|length==1?'hidden':''}}>

					{{ 'inputSectionFilter.label'|trans }}

					<select class="form-select"
							name="{{ fieldFilterFieldName }}"
							data-js-section-filter>

						{% for fieldFilterName, fieldFilterValue in this.sectionFilters %}

						{% if fieldFilterName==data.fieldFilterValue %}

						<option value="{{ fieldFilterName }}"
								selected>

							{{ fieldFilterValue }}
						</option>

						{% else %}

						<option value="{{ fieldFilterName }}">{{ fieldFilterValue }}</option>

						{% endif %}
						{% endfor %}
					</select>
				</label>

				<label>

					{{ 'inputTextFilter.label'|trans }}

					<select class="form-select"
							name="{{ nameFilterFieldName }}"
							data-js-name-filter>

						{% for nameFilterName, valueFilterLang in nameFilters %}

						{% if nameFilterName==data.nameFilterValue %}

						<option value="{{ nameFilterName }}"
								selected>{{ valueFilterLang }}</option>

						{% else %}

						<option value="{{ nameFilterName }}">{{ valueFilterLang }}</option>

						{% endif %}

						{% endfor %}
					</select>
				</label>

				<label>

					{{ 'inputTextBoxFilter.label'|trans }}

					<input type="text"
						   class="form-control"
						   name="{{ searchValueFieldName }}"
						   placeholder="{{ 'inputSearch.placeholder'|trans }}"
						   value="{{ data.searchValue }}"
						   list="search-data-list"
						   data-js-value />
				</label>

				<label hidden>

					{{ 'inputCategoryFilter.label'|trans }}

					<select class="form-select"
							name="{{ searchValueFieldName }}"
							data-js-category-filter>

						{% for categoryFilterName, valueFilterLang in categoryFilters %}

							{% if categoryFilterName==data.searchValue %}

								<option value="{{ categoryFilterName }}"
										selected>{{ valueFilterLang }}</option>

							{% else %}

								<option value="{{ categoryFilterName }}">{{ valueFilterLang }}</option>

							{% endif %}

						{% endfor %}
					</select>
				</label>

				<button type="submit"
						class="btn btn-primary  order-3  mt-4  mb-3"
						name="{{ searchButtonFiledName }}"
						alt="{{ 'button.label'|trans }}">
					{% include "common/search-icon.svg" %}
					{{ 'button.label'|trans }}
				</button>
			</form>
		</div>
	</div>
</section>